# 复制此文件为 .env 并填写你的 API Key
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)

EXPO_PUBLIC_CLOUD_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SILICONFLOW_API_KEY=你的硅基流动API_Key
SILICONFLOW_API_KEY=你的硅基流动API_Key

CLOUD_PORT=4000
CLOUD_JWT_SECRET=local_dev_secret_change_in_production
CLOUD_DB_PATH=./cloud-data/cloud.db

# 可选：百度 OCR / 药品库
# BAIDU_API_KEY=
# BAIDU_SECRET_KEY=
# JUHE_API_KEY=
